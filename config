ngx_addon_name=ngx_http_redis_module

REDIS_SRCS="$ngx_addon_dir/src/ngx_http_redis_module.c"

if [ -n "$ngx_module_link" ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_redis_module
    ngx_module_srcs="$REDIS_SRCS"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_redis_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $REDIS_SRCS"
fi
